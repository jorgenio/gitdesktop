<?xml version='1.0' encoding='windows-1252'?>
<!--
  Instalador MSI de Git-Desktop Jorgenio (schema WiX 3.x, consumido por
  candle/light en CI). Variables definidas por el workflow:
  - $(var.ExePath)        ruta del ejecutable release
  - $(var.IconPath)       ruta del icono .ico
  - $(var.ProductVersion) versión del tag (vX.Y.Z -> X.Y.Z)
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='Git-Desktop Jorgenio'
    UpgradeCode='8E4B6F5A-2C7D-4B8E-9A1F-3D5C7E9B1A2C'
    Language='1033'
    Codepage='1252'
    Version='$(var.ProductVersion)'
    Manufacturer='Jorgenio'>

    <Package
      InstallerVersion='500'
      Compressed='yes'
      InstallScope='perMachine'
      Platform='x64'
      Description='Cliente Git de escritorio en Rust'
      Manufacturer='Jorgenio' />

    <MajorUpgrade
      AllowDowngrades='no'
      DowngradeErrorMessage='Ya hay una versión más nueva de [ProductName] instalada.'
      Schedule='afterInstallInitialize' />

    <MediaTemplate EmbedCab='yes' />

    <!-- Icono para Agregar o quitar programas y accesos directos -->
    <Icon Id='AppIcon' SourceFile='$(var.IconPath)' />
    <Property Id='ARPPRODUCTICON' Value='AppIcon' />
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/jorgenio/gitdesktop' />

    <Feature
      Id='MainProgram'
      Title='Git-Desktop Jorgenio'
      Description='Instala el ejecutable y los accesos directos.'
      Level='1'
      Absent='disallow'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='StartMenuShortcut' />
    </Feature>

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <!-- Ejecutable: datos por-máquina con KeyPath de archivo -->
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='INSTALLFOLDER' Name='Git-Desktop Jorgenio'>
          <Component Id='MainExecutable' Guid='*'>
            <File
              Id='GitDesktopExe'
              Name='git-desktop-jorgenio.exe'
              Source='$(var.ExePath)'
              KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>

      <!-- Acceso directo: datos por-usuario con KeyPath HKCU (ICE43/ICE57) -->
      <Directory Id='ProgramMenuFolder'>
        <Component Id='StartMenuShortcut' Guid='*'>
          <Shortcut
            Id='StartMenuShortcutEntry'
            Name='Git-Desktop Jorgenio'
            Description='Cliente Git de escritorio en Rust'
            Target='[INSTALLFOLDER]git-desktop-jorgenio.exe'
            WorkingDirectory='INSTALLFOLDER'
            Icon='AppIcon' />
          <RemoveFolder Id='RemoveProgramsFolder' On='uninstall' />
          <RegistryValue
            Root='HKCU'
            Key='Software\Jorgenio\GitDesktopJorgenio'
            Name='shortcut'
            Type='integer'
            Value='1'
            KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>
  </Product>
</Wix>
